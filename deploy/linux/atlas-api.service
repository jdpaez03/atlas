[Unit]
Description=ATLAS API (orchestrator, agents, ARGOS, SCRIBE)
After=network-online.target atlas-xvfb.service
Wants=network-online.target atlas-xvfb.service

[Service]
User=@USER@
WorkingDirectory=@ATLAS_DIR@/apps/api
Environment=DISPLAY=:99
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=@UV@ run --frozen python -m atlas --host 127.0.0.1 --port @API_PORT@
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
