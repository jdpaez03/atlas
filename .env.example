# --- LLM backend for live missions (docs/LIVE.md § Backends) ---------------------------------------
# api           Claude API with ANTHROPIC_API_KEY (billed per token)
# subscription  your Claude Pro/Max plan: Claude Code (logged in with `claude` → /login) via the Claude Agent SDK
# auto          (default) api if ANTHROPIC_API_KEY is set, else subscription if Claude Code is usable, else live off
ATLAS_LLM_BACKEND=auto
# Optional: path to the Claude Code CLI (claude.exe on Windows). Default: the CLI bundled with claude-agent-sdk,
# then PATH. The login is shared either way (~/.claude). On Windows, npm's claude.cmd shim is not supported.
# ATLAS_CLAUDE_CLI=C:/Users/<you>/.local/bin/claude.exe

# Anthropic API key (api backend). Create one at https://platform.claude.com — billed separately from Claude Max.
# Keep it ONLY in this file; do not set it as a system-wide environment variable. Leave it empty to use your Max
# plan with ATLAS_LLM_BACKEND=auto (the subscription backend never passes it to Claude Code).
ANTHROPIC_API_KEY=
# With a usable backend, POST /missions without a mode runs LIVE. Without one, missions are simulated.

# --- Live missions (Phase 2, docs/LIVE.md) ---------------------------------------------------------
# Models: orchestrator (planning/review/consolidation), specialists, and the fast model for consultations.
# claude_md agents map their frontmatter model: opus -> orchestrator, sonnet -> ATLAS_MODEL, haiku -> fast.
# Defaults: api -> claude-opus-5-5 / claude-sonnet-5 / claude-haiku-4-5-20251001; subscription -> opus / sonnet / haiku
# (Claude Code aliases). Uncomment only to override.
# ATLAS_ORCHESTRATOR_MODEL=claude-opus-5-5
# ATLAS_MODEL=claude-sonnet-5
# ATLAS_FAST_MODEL=claude-haiku-4-5-20251001
# Tasks running at once across all live missions (each agent is also capped by permissions.max_parallel_tasks)
ATLAS_MAX_CONCURRENCY=4
# Max tool-use turns per agent task (default 8 on api, 12 on subscription), and max consult() calls per task
# ATLAS_MAX_TURNS=8
ATLAS_MAX_CONSULTS=2
# Web search. api: server-side web search for agents whose YAML tools include web_search (SOFIA); off unless 1,
# billed per search. subscription: WebSearch/WebFetch for research agents (SOFIA, MERCATO); ON unless 0.
# ATLAS_WEB_SEARCH=0
# Web search tool version string sent to the API (fallback if your model rejects it: web_search_20250305)
ATLAS_WEB_SEARCH_TOOL=web_search_20260318
# Private context folder (never committed): <dir>/context/<node>/**/*.md|txt, <dir>/context/<node>/<division>/...
# Default: ../atlas-local next to the repo. Truncated per agent to ATLAS_CONTEXT_MAX_CHARS.
# ATLAS_LOCAL_DIR=../atlas-local
ATLAS_CONTEXT_MAX_CHARS=150000
# Cost ESTIMATES, USD per million tokens (defaults: opus 5/25, sonnet 3/15, haiku 1/5; cache reads 10% of input).
# Keys: exact model id or class (opus|sonnet|haiku). Values: {"input":x,"output":y,"cache_read"?:z} or [x, y].
# ATLAS_PRICES={"claude-sonnet-5": {"input": 3, "output": 15}}

ATLAS_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_ATLAS_API_URL=http://localhost:8000

# Folder with your Claude Code agents (claude_md adapter), e.g. C:/Users/<you>/.claude/agents
ATLAS_CLAUDE_AGENTS_DIR=~/.claude/agents
