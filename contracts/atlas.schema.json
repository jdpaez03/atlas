    "NodeDefinition": {
      "description": "An isolated operating context (e.g. corporate, personal).\n\nIsolation rule: a mission lives in exactly one node. Node-bound agents only work on missions of\ntheir node; shared agents (nodes: ['*']) serve every node but never carry context between them.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "color": {
          "default": "#7dd3fc",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "color",
        "enabled"
